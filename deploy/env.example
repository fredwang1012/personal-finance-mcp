# /etc/personal-finance-mcp/env  (root:pfmcp, mode 0640). Non-secret settings only.
# Secrets live in systemd credentials under /etc/credstore.encrypted/personal-finance-mcp/.
PLAID_ENV=production
SECRETS_BACKEND=systemd
DATA_DIR=/var/lib/personal-finance-mcp

# The public HTTPS origin Tailscale Funnel gives this machine, without a path or trailing slash.
# The connector URL to paste into claude.ai is this plus /mcp.
PUBLIC_URL=https://CHANGE-ME.your-tailnet.ts.net
HTTP_PORT=8765

# GitHub OAuth App (Settings > Developer settings > OAuth Apps). The client id is not secret.
GITHUB_CLIENT_ID=CHANGE-ME
# Your numeric GitHub user id (not your login): curl -s https://api.github.com/users/YOUR_LOGIN | grep '"id"'
GITHUB_ALLOWED_USER_ID=0

# Requests without X-Forwarded-For (a wrong Funnel target) get 503. Set false only to test directly on the VM.
REQUIRE_FORWARDED_FOR=true
