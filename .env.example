# Non-secret settings only. Copy to .env (gitignored) to change them; every line is optional.
# Plaid credentials and access tokens never go here: they live in the OS keychain (python -m app.cli set-plaid-keys).

# Which Plaid environment to use: sandbox (fake data, default) or production (your real accounts).
PLAID_ENV=sandbox

# Where the local SQLite store (finance.db) is kept. A relative path is relative to the repo root. Default: data
# DATA_DIR=data

# Country codes passed to Plaid Link, as a JSON list. Default: ["CA"]
# COUNTRY_CODES=["CA"]

# PFMCP_FAKE_PLAID is a test-only switch used by tests/test_e2e.py. Do not set it here; the server ignores it unless
# PYTEST_CURRENT_TEST is set (only pytest sets it) and DATA_DIR is inside pytest's temp directory (see app/testmode.py).

# Remote connector (python -m app.cli serve-http; see docs/REMOTE.md). On the server these go in
# /etc/personal-finance-mcp/env instead. Secrets backend: keyring (default) or systemd.
# SECRETS_BACKEND=keyring
# PUBLIC_URL=https://your-machine.your-tailnet.ts.net
# HTTP_PORT=8765
# GITHUB_CLIENT_ID=
# GITHUB_ALLOWED_USER_ID=0
